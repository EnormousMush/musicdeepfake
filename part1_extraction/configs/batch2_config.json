{
  "model": "chirp-v5",
  "api_key_env": "TTAPI_KEY",
  "output_dir": "audio",
  "manifest_path": "manifests/batch2_manifest.csv",
  "frozen_prompts_path": "manifests/batch2_frozen_prompts.csv",
  "word_lists_dir": "word_lists",

  "concurrency": {
    "max_queue": 10,
    "poll_batch": 50,
    "download_workers": 4,
    "cycle_sleep": 10
  },

  "genres": {
    "rock":      { "target_tracks": 3000, "instrumental": true },
    "pop":       { "target_tracks": 3000, "instrumental": true },
    "classical": { "target_tracks": 2500, "instrumental": true }
  }
}
